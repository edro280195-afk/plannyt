# PostgreSQL local. Valores ficticios exclusivos para desarrollo.
POSTGRES_DB=plannyt
POSTGRES_USER=plannyt
POSTGRES_PASSWORD=change-me-development-only
POSTGRES_PORT=5434

# API
ConnectionStrings__DefaultConnection=Host=localhost;Port=5434;Database=plannyt;Username=plannyt;Password=change-me-development-only
Jwt__Issuer=plannyt-api
Jwt__Audience=plannyt-web
Jwt__SigningKey=replace-with-at-least-64-random-characters-development-only
GuestAccessTokens__ActiveKeyId=development-2026-01
GuestAccessTokens__Keys__development-2026-01=replace-with-a-separate-random-key-of-at-least-64-characters
Cors__AllowedOrigin=http://localhost:4200
Frontend__PublicUrl=http://localhost:4200
FileStorage__RootPath=storage
Database__MigrateOnStartup=false

# Datos demo, deshabilitados por defecto.
DemoSeed__Enabled=false
DemoSeed__PlannerEmail=planner.demo@example.invalid
DemoSeed__PlannerPassword=replace-only-in-your-local-env
DemoSeed__ClientEmail=ana.demo@example.invalid
